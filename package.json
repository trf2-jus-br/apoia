{
  "name": "apoia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env DOTENV_CONFIG_QUIET=true next dev -p 8081",
    "build": "npm run copy-lamejs && cross-env DOTENV_CONFIG_QUIET=true NODE_OPTIONS=\"--max-old-space-size=4096\" npx next-swagger-doc-cli next-swagger-doc.json && cross-env DOTENV_CONFIG_QUIET=true NODE_OPTIONS=\"--max-old-space-size=4096\" next build",
    "start": "cross-env DOTENV_CONFIG_QUIET=true next start -p 8088",
    "lint": "next lint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run lint && npm run typecheck",
    "knex": "ts-node -P tsconfig.knex.json node_modules/knex/bin/cli.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "copy-lamejs": "node -e \"require('fs').copyFileSync('node_modules/lamejs/lame.min.js', 'public/lame.min.js')\"",
    "prepare": "node -e \"const fs=require('fs'); const src='scripts/pre-commit'; const dst='.git/hooks/pre-commit'; try { fs.copyFileSync(src, dst); fs.chmodSync(dst, 0o755); } catch(e) { /* skip outside git repo */ }\""
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.2",
    "@ai-sdk/anthropic": "^3.0.1",
    "@ai-sdk/azure": "^3.0.1",
    "@ai-sdk/deepseek": "^2.0.1",
    "@ai-sdk/google": "^3.0.1",
    "@ai-sdk/groq": "^3.0.1",
    "@ai-sdk/openai": "^3.0.1",
    "@ai-sdk/provider": "^3.0.0",
    "@ai-sdk/react": "^3.0.3",
    "@aws-sdk/credential-providers": "^3.946.0",
    "@edge-runtime/cookies": "^6.0.0",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-regular-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/react-fontawesome": "^0.2.6",
    "@mdxeditor/editor": "^3.52.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@next/bundle-analyzer": "16.1.2",
    "@next/third-parties": "16.1.2",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@pro-fa/expreszo": "^0.6.6",
    "@sentry/nextjs": "^10.29.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/diff-match-patch": "^1.0.36",
    "@types/jsdom": "^27.0.0",
    "@types/knex": "^0.16.1",
    "@types/ms": "^2.1.0",
    "@types/node": "24.2.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vercel/postgres": "^0.10.0",
    "ai": "^6.0.3",
    "autoprefixer": "10.4.21",
    "axios": "^1.13.2",
    "bootstrap": "^5.3.8",
    "cryptr": "^6.4.0",
    "dayjs": "^1.11.19",
    "diff-htmls": "^0.0.1",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.3.0",
    "eureka-js-client": "^4.5.0",
    "file-type": "^22.0.1",
    "glob": "^13.0.0",
    "html2canvas": "^1.4.1",
    "http": "^0.0.1-security",
    "ia": "^0.0.1-beta",
    "js-yaml": "^4.1.0",
    "jsdom": "^26.1.0",
    "json-canonicalize": "^2.0.0",
    "knex": "^3.1.0",
    "lamejs": "^1.2.1",
    "lodash": "^4.17.21",
    "mcp-handler": "^1.1.0",
    "ms": "^2.1.3",
    "mysql2": "^3.15.3",
    "net": "^1.0.2",
    "next": "16.1.2",
    "next-auth": "^4.24.13",
    "next-swagger-doc": "^0.4.1",
    "nunjucks": "^3.2.4",
    "p-limit": "^6.2.0",
    "partial-json": "^0.1.7",
    "pdf-parse": "^1.1.4",
    "pdfmake": "^0.2.20",
    "pg": "^8.16.3",
    "plotly.js": "^3.3.0",
    "raw-loader": "^4.0.2",
    "react": "19.2.3",
    "react-bootstrap": "^2.10.10",
    "react-diff-components": "^0.0.4",
    "react-dom": "19.2.3",
    "react-pivottable": "^0.11.0",
    "react-plotly.js": "^2.6.0",
    "react-textarea-autosize": "^8.5.9",
    "recharts": "^3.5.1",
    "sharp": "^0.34.5",
    "showdown": "^2.1.0",
    "soap": "^1.6.1",
    "string-comparison": "^1.3.0",
    "swagger-ui": "^5.30.3",
    "tar-stream": "^3.1.8",
