    "turndown": "^7.2.2",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.21",
    "@types/tar-stream": "^3.1.4",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.1.2",
    "glob": "^13.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.next/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "\\.(md)$": "<rootDir>/txtTransformer.js"
    },
    "transform": {
      "\\.txt$": "<rootDir>/txtTransformer.js"
    },
    "moduleFileExtensions": [
      "js",
      "ts",
      "json",
      "txt"
    ],
    "testMatch": [
      "**/__tests__/**/*.+(test.ts|spec.ts)",
      "**/?(*.)+(spec|test).+(ts|tsx)"
    ]
  },
  "overrides": {
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3"
  }
}
